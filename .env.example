# MacMine Lab — environment variables
#
# The local app (backend/frontend) needs none of these to run; it uses
# hardcoded localhost defaults. These only apply to the two separate
# pieces below.

# --- frontend/ (optional overrides, only needed if you run the backend
#     on a non-default port) ---
NEXT_PUBLIC_MACMINE_API_BASE=http://127.0.0.1:8834
NEXT_PUBLIC_MACMINE_WS_BASE=ws://127.0.0.1:8834

# --- showcase/ (Vercel-deployed static guide site — set these in the
#     Vercel project's env vars, not in a local .env file) ---
GUIDE_PASSWORD=replace-with-a-real-password
GUIDE_SESSION_TOKEN=replace-with-a-long-random-token
